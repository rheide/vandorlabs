{
  "multipart": [
    {
      "when": { "facing": "south", "half": "lower", "hinge": "left", "paired": "false" },
      "apply": { "model": "vandorlabs:detailed_doors/detail_engineering_sliding_single_right_fixed" }
    },
    {
      "when": { "facing": "south", "half": "lower", "hinge": "right", "paired": "false" },
      "apply": { "model": "vandorlabs:detailed_doors/detail_engineering_sliding_single_left_fixed" }
    },
    {
