    },
    {
      "when": { "facing": "west", "half": "lower", "hinge": "right", "paired": "false" },
      "apply": { "model": "vandorlabs:detailed_doors/detail_engineering_sliding_single_left_fixed", "y": 90 }
    },
    {
      "when": { "facing": "north", "half": "lower", "hinge": "left", "paired": "false" },
      "apply": { "model": "vandorlabs:detailed_doors/detail_engineering_sliding_single_right_fixed", "y": 180 }
